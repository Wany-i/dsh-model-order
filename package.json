{
  "name": "dsh-model-order",
  "version": "0.1.0",
  "description": "Reorder the model list of any llm-pi-ai route from Settings > Models; the composer model menu follows the same order.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-models"
      ]
    },
    "marketplace": {
      "profiles": [
        "web",
        "desktop"
      ],
      "requiresRestart": true,
      "manualSteps": false,
      "requiresBuildApproval": false
    },
    "compatibility": {
      "dsh": ">=0.2.0-rc.1 <0.3.0-0",
      "node": ">=20"
    }
  },
  "license": "MIT",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown --config ./tsdown.config.ts",
    "watch": "tsdown --config ./tsdown.config.ts --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node test/order.spec.mjs && node test/section.spec.mjs && node test/patch.spec.mjs && node test/bundle.spec.mjs && node test/render.spec.mjs",
    "verify": "npm run typecheck && npm run build && npm test"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-api-remotes": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-store": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-settings-models": "0.2.0-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.2",
    "@deepseek-ai/dsh-settings": "0.2.0-rc.2",
    "@deepseek-ai/schemastery": "3.18.4",
    "@types/node": "^24.0.0",
    "@types/react": "18.3.1",
    "jsdom": "^30.1.1",
    "lightningcss": "^1.32.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "^0.22.2",
    "typescript": "^5.9.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Wany-i/dsh-model-order.git"
  },
  "homepage": "https://github.com/Wany-i/dsh-model-order",
  "bugs": {
    "url": "https://github.com/Wany-i/dsh-model-order/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "model-order",
    "model-sort",
    "settings",
    "llm-pi-ai",
    "client-plugin"
  ]
}
